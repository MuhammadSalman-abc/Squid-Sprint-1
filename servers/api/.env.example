NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# MONGODB_URI=mongodb://127.0.0.1:27017/workspace
# Set these only in a preview environment, then run `pnpm --filter @workspace/api seed:preview`.
# PREVIEW_USER_EMAIL=member@example.test
# PREVIEW_USER_PASSWORD=use-a-strong-secret-value
# PREVIEW_WORKSPACE_ID=preview-workspace
# REDIS_URL=redis://127.0.0.1:6379
# Optional comma-separated DNS resolvers for MongoDB SRV lookups.
DNS_SERVERS=
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?appName=<app-name>
# Temporary, local-only organization-branding demo login. Keep disabled by default.
# Use a separate demo email/password (password >= 16 chars) and random session secret >= 32 chars.
# Never commit real values. Configure the same email/password in the local web browser form.
# TEMP_ORG_BRANDING_DEMO_ENABLED=true
# TEMP_ORG_BRANDING_DEMO_EMAIL=demo@example.local
# TEMP_ORG_BRANDING_DEMO_PASSWORD=
# TEMP_ORG_BRANDING_DEMO_WORKSPACE_ID=
# TEMP_ORG_BRANDING_DEMO_SESSION_SECRET=
LOG_FORMAT=json
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
OIDC_CALLBACK_BASE_URL=http://localhost:3000
# Generate a fresh 32-byte base64url key for local OIDC development.
# OIDC_FLOW_COOKIE_KEY=
# MONGODB_URI=mongodb://127.0.0.1:27017/squid
# MICROSOFT_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# MICROSOFT_OIDC_CLIENT_ID=
# MICROSOFT_OIDC_CLIENT_SECRET=
